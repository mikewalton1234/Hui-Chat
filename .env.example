# Hui Chat environment placeholders. Copy to .env for local deployment.

# Database / secrets
# Local Arch/Linux PostgreSQL example. Replace YOUR_LINUX_USERNAME or generate
# a ready .env from the shell with:
#   printf 'DATABASE_URL=postgresql://%s@localhost:5432/hui_chat\nHUI_DB_BOOTSTRAP_URL=postgresql://%s@localhost:5432/postgres\n' "$USER" "$USER" >> .env
DATABASE_URL=postgresql://YOUR_LINUX_USERNAME@localhost:5432/hui_chat
HUI_DB_BOOTSTRAP_URL=postgresql://YOUR_LINUX_USERNAME@localhost:5432/postgres
# Generate real secrets with:
#   python main.py --generate-secrets --write-env-secrets
# Do not uncomment placeholder values; runtime rejects CHANGE_ME/example secrets.
# SECRET_KEY=
# JWT_SECRET_KEY=
# HUI_PROFILE_FIELD_KEY=
# HUI_EMAIL_FIELD_KEY=
# HUI_EMAIL_HASH_KEY=
# HUI_SECURITY_BACKUP_KEY=
# HUI_PRIVACY_HASH_KEY=
FERNET_KEY=

# Startup mode defaults
HUI_RUN_MODE=development
# Keep this at 1 for the built-in Flask-SocketIO/Gunicorn runner.
HUI_PRODUCTION_WORKERS=1
# Horizontal scale target. Keep workers=1; use up to 10 separate instances behind sticky proxy + Redis.
HUI_PRODUCTION_INSTANCES=1
HUI_INSTANCE_BASE_PORT=5000
HUI_SOCKETIO_ASYNC=threading
HUI_GUNICORN_WORKER_CLASS=gthread
HUI_GUNICORN_THREADS=100

# Hosting / browser origin defaults
HUI_HOSTING_MODE=lan
HUI_PUBLIC_BASE_URL=http://127.0.0.1:5000
HUI_PUBLIC_URL=http://127.0.0.1:5000
HUI_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
HUI_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
HUI_COOKIE_SECURE=0
HUI_COOKIE_SAMESITE=Lax
HUI_TRUST_PROXY_HEADERS=false
HUI_PROXY_FIX_HOPS=1
HUI_FORWARDED_ALLOW_IPS=127.0.0.1
HUI_ENABLE_HEALTH_ENDPOINT=false
HUI_HEALTH_ENDPOINT=/healthz

# Socket.IO / Redis topology defaults
HUI_SOCKETIO_TRANSPORTS=polling
HUI_AUTO_ALLOW_LAN_ORIGINS=true
# LAN/local default avoids requiring Redis. Public beta or multi-instance mode should use:
#   HUI_RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
#   HUI_SOCKETIO_MESSAGE_QUEUE=redis://127.0.0.1:6379/1
#   HUI_SHARED_STATE_REDIS_URL=redis://127.0.0.1:6379/2
HUI_RATE_LIMIT_STORAGE_URI=memory://
HUI_SOCKETIO_MESSAGE_QUEUE=
# Set to 1 only when a one-worker process intentionally needs external Socket.IO emitters.
HUI_FORCE_SOCKETIO_REDIS_QUEUE=0
HUI_SHARED_STATE_REDIS_URL=
# REDIS_URL is intentionally not used as the Socket.IO queue; use the explicit DB split above.


# WebRTC STUN/TURN for webcam, voice, and P2P file testing
# STUN-only works on many LAN/home networks. Add TURN for internet/cellular/firewall reliability.
# JSON form accepts full RTCIceServer objects, including username/credential.
HUI_WEBRTC_ICE_SERVERS_JSON=
HUI_VOICE_ICE_SERVERS_JSON=
# Simpler TURN-only form; applied to both P2P and voice/webcam if JSON vars above are blank.
HUI_TURN_URLS=
HUI_TURN_USERNAME=
HUI_TURN_CREDENTIAL=

# Optional Dynamic DNS helper
HUI_DYNAMIC_DNS_ENABLED=0
HUI_DYNAMIC_DNS_PROVIDER=No-IP
HUI_DYNAMIC_DNS_DOMAIN=
HUI_DYNAMIC_DNS_USERNAME=
HUI_DYNAMIC_DNS_PASSWORD=
HUI_DYNAMIC_DNS_UPDATE_URL=https://dynupdate.no-ip.com/nic/update

# Optional email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
HUI_SMTP_USERNAME=


# Optional test automation credentials
HUI_TEST_ADMIN_USERNAME=
HUI_TEST_ADMIN_PASSWORD=

# Profile-field key rotation: keep old key(s) here only during rotation.
# HUI_PROFILE_FIELD_PREVIOUS_KEYS=old-key-1,old-key-2

# At-rest encryption keys. Keep stable and backed up before running migrations/rotation.
HUI_PROFILE_FIELD_KEY=
HUI_EMAIL_FIELD_KEY=
HUI_EMAIL_HASH_KEY=
HUI_SECURITY_BACKUP_KEY=

# Enable server-side tracker scraping for live room torrent seeds/leechers/completed.
# Recommended for local/LAN testing; use caution on public internet servers.
HUI_TORRENT_SCRAPE_ENABLED=0
